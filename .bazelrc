# Bazel configuration for MegaGate

# Build configuration
build --config=release
build --show_timestamps
build --verbose_failures

# Remote caching (optional, configure for your setup)
# build --remote_cache=https://cache.example.com
# build --remote_upload_local_results=true

# Rust specific
build --@rules_rust//rust:default_edition=2021
build --@rules_rust//rust:default_features=all

# Test configuration
test --test_output=all
test --test_timeout=300

# Protobuf
build --@rules_proto//proto:protoc=@protobuf//:protoc

# Output
build --experimental_ui_limit_console_output=100
build --color=yes

# Platforms
build --platforms=@platforms//cpu/x86_64
build --platforms=@platforms//os/linux
build --platforms=@platforms//os/macos

# Remote execution (optional)
# build --remote_executor=grpc://remote.example.com:443
# build --remote_instance_name=projects/my-project/instances/default

# Cache
build --disk_cache=~/.cache/bazel/disk
build --repository_cache=~/.cache/bazel/repo

# Output user root
startup --output_user_root=~/.cache/bazel