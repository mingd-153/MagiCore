{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src/webapp-core/src"
  },
  "include": ["src/webapp-core/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
