use axum::{
    extract::{Path, State},
    http::StatusCode,
    response::Json,
    routing::{get, post},
    Router,
};
use serde_json::Value;
use sqlx::PgPool;

use crate::models::item::{CreateItem, Item};

pub fn routes() -> Router<PgPool> {
    Router::new()
        .route("/", get(list))
        .route("/", post(create))
        .route("/{id}", get(get_by_id))
}

async fn list(State(pool): State<PgPool>) -> Json<Value> {
    let items = sqlx::query_as::<_, Item>("SELECT * FROM items")
        .fetch_all(&pool)
        .await
        .unwrap_or_default();
    Json(serde_json::json!({ "data": items }))
}

async fn get_by_id(State(pool): State<PgPool>, Path(id): Path<i32>) -> Result<Json<Value>, StatusCode> {
    sqlx::query_as::<_, Item>("SELECT * FROM items WHERE id = $1")
        .bind(id)
        .fetch_optional(&pool)
        .await
        .map(|item| match item {
            Some(item) => Ok(Json(serde_json::json!({ "data": item }))),
            None => Err(StatusCode::NOT_FOUND),
        })
        .unwrap_or(Err(StatusCode::INTERNAL_SERVER_ERROR))
}

async fn create(State(pool): State<PgPool>, Json(input): Json<CreateItem>) -> Result<Json<Value>, StatusCode> {
    let item = sqlx::query_as::<_, Item>(
        "INSERT INTO items (name, description) VALUES ($1, $2) RETURNING *",
    )
    .bind(&input.name)
    .bind(&input.description)
    .fetch_one(&pool)
    .await
    .map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?;

    Ok(Json(serde_json::json!({ "data": item })))
}
