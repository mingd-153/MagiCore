*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; } :root
{ --color-primary: #646cff; --color-bg: #ffffff; --color-text: #213547; } body {
font-family: Inter, system-ui, sans-serif; color: var(--color-text);
background-color: var(--color-bg); line-height: 1.5; } #app { max-width: 1280px;
margin: 0 auto; padding: 2rem; }
