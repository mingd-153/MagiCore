defmodule {{pascalCase name}}.Web.Router do
  use {{pascalCase name}}.Web, :router

  pipeline :api do
    plug :accepts, ["json"]
  end

  scope "/api", {{pascalCase name}}.Web do
    pipe_through :api
    get "/items", ItemController, :index
    get "/items/:id", ItemController, :show
    post "/items", ItemController, :create
  end

  scope "/", {{pascalCase name}}.Web do
    get "/health", HealthController, :show
  end
end
