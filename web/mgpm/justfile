# MGPM Development Tasks
# Usage: just <task>

default: check

# ===== Build =====
build:
	cargo build --workspace --all-targets

build-release:
	cargo build --workspace --release --all-targets

# ===== Check =====
fmt:
	cargo fmt --all -- --check

clippy:
	cargo clippy --workspace --all-targets --all-features -- -D warnings

check: fmt clippy

# ===== Test =====
test:
	cargo test --workspace --all-targets

test-unit:
	cargo test --workspace --lib

test-integration:
	cargo test --workspace --test integration

bench:
	cargo bench --workspace

# ===== Docs =====
doc:
	cargo doc --workspace --no-deps

doc-open:
	cargo doc --workspace --no-deps --open

# ===== Clean =====
clean:
	cargo clean

# ===== CI =====
ci: check test

# ===== Cross-compile =====
cross:
	cargo build --workspace --target x86_64-unknown-linux-gnu --target aarch64-unknown-linux-gnu --target x86_64-apple-darwin --target aarch64-apple-darwin --target x86_64-pc-windows-msvc

# ===== Individual crates =====
%:
	cargo build -p mgpm-$*

test-%:
	cargo test -p mgpm-$*

bench-%:
	cargo bench -p mgpm-$*

doc-%:
	cargo doc -p mgpm-$* --no-deps

# ===== Generator =====
gen-lockfile:
	@cargo run -p mgpm-cli --bin mgpm -- lockfile generate

# ===== Development =====
dev-setup:
	rustup component add rustfmt clippy
	cargo install cargo-audit cargo-deny cargo-nextest cargo-llvm-cov
	rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu x86_64-apple-darwin aarch64-apple-darwin x86_64-pc-windows-msvc

# ===== Security =====
audit:
	cargo audit --deny warnings

deny:
	cargo deny check licenses advisories bans sources

# ===== Coverage =====
coverage:
	cargo llvm-cov --workspace --html --output-dir coverage

# ===== Release =====
release-dry:
	cargo release --dry-run --no-publish

release:
	cargo release --no-publish

.PHONY: build build-release fmt clippy check test test-unit test-integration bench doc doc-open clean ci cross dev-setup audit deny coverage release-dry release
