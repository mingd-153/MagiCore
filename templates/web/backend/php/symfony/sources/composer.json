{
    "name": "{{ project_slug }}/api",
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/string": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
