defmodule {{pascalCase name}}.Web.ItemController do
  use {{pascalCase name}}.Web, :controller

  alias {{pascalCase name}}.Accounts

  def index(conn, _params) do
    items = Accounts.list_items()
    json(conn, %{data: items})
  end

  def show(conn, %{"id" => id}) do
    case Accounts.get_item(id) do
      nil -> conn |> put_status(:not_found) |> json(%{message: "Item not found"})
      item -> json(conn, %{data: item})
    end
  end

  def create(conn, params) do
    case Accounts.create_item(params) do
      {:ok, item} -> conn |> put_status(:created) |> json(%{data: item})
      {:error, changeset} -> conn |> put_status(:unprocessable_entity) |> json(%{errors: changeset.errors})
    end
  end
end
