default: &default
  adapter: postgresql
  encoding: unicode
  pool: 5
  host: <%= ENV.fetch("DB_HOST", "localhost") %>
  username: <%= ENV.fetch("DB_USERNAME", "postgres") %>
  password: <%= ENV.fetch("DB_PASSWORD", "postgres") %>

development:
  <<: *default
  database: {{name}}_development

test:
  <<: *default
  database: {{name}}_test

production:
  <<: *default
  database: {{name}}_production
  url: <%= ENV["DATABASE_URL"] %>
