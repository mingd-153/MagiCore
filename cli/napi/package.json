{
  "name": "megagate-core",
  "version": "0.1.0",
  "description": "MegaGate Rust Core NAPI bindings for TypeScript/Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "megagate_core.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node test.js"
  },
  "napi": {
    "name": "megagate_core",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
