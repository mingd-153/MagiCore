# MagiCore Registry — Environment Variables
# Copy this file to registry.env and fill in your values.
# NEVER commit registry.env — it contains secrets.

# ── Server config ──────────────────────────────────────────────────────────────
MAGICORE_REGISTRY_HOST=0.0.0.0
MAGICORE_REGISTRY_PORT=4315
MAGICORE_REGISTRY_STORE_DIR=/data

# ── Security ───────────────────────────────────────────────────────────────────
# Admin token used to create/manage users via POST /v2/admin/*
# Generate with: openssl rand -hex 32
MAGICORE_REGISTRY_ADMIN_TOKEN=changeme_generate_with_openssl_rand_hex_32

# Optional. Keep both values commented to leave trusted publishing disabled.
# Tùy chọn. Giữ cả hai dòng comment để tắt trusted publishing.
# MAGICORE_REGISTRY_OIDC_ISSUER=https://token.actions.githubusercontent.com
# MAGICORE_REGISTRY_OIDC_AUDIENCE=https://registry.example.com

# Set the exact peer IP observed by the registry; do not guess the Docker gateway address.
# Khai báo IP peer mà registry thực sự quan sát được; không tự đoán IP gateway Docker.
# Leave unset to reject trusted-token requests unless the server binds to loopback.
# Không khai báo biến để từ chối trusted token, trừ khi server bind loopback.
# MAGICORE_REGISTRY_TRUSTED_PROXY_IPS=

# ── Logging ────────────────────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error
MAGICORE_LOG_LEVEL=info
