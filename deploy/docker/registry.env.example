# MegaGate Registry — Environment Variables
# Copy this file to registry.env and fill in your values.
# NEVER commit registry.env — it contains secrets.

# ── Server config ──────────────────────────────────────────────────────────────
MEGAGATE_REGISTRY_HOST=0.0.0.0
MEGAGATE_REGISTRY_PORT=8080
MEGAGATE_REGISTRY_STORE_DIR=/data

# ── Security ───────────────────────────────────────────────────────────────────
# Admin token used to create/manage users via POST /v2/admin/*
# Generate with: openssl rand -hex 32
MEGAGATE_REGISTRY_ADMIN_TOKEN=changeme_generate_with_openssl_rand_hex_32

# ── Logging ────────────────────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error
MEGAGATE_LOG_LEVEL=info

# ── mg CLI (used in --profile cli sidecar) ────────────────────────────────────
MG_REGISTRY=http://registry:8080
MG_AUTH_TOKEN=
