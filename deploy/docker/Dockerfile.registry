# MegaGate Registry Server — multi-stage build
# Usage: docker build -f deploy/docker/Dockerfile.registry -t megagate/registry-server .
ARG RUST_IMAGE=docker.io/library/rust:1.85-slim-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

# ── Build stage ───────────────────────────────────────────────────────────────
FROM ${RUST_IMAGE} AS build
WORKDIR /build

RUN apt-get update -qq && apt-get install -y -qq \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY adapters/ adapters/
COPY cli/ cli/
COPY tools/ tools/

RUN cargo build --release --package mg-registry-server && \
    cp target/release/mg-registry-server /mg-registry-server

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM ${RUNTIME_IMAGE}

RUN apt-get update -qq && apt-get install -y -qq wget ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -g root mgreg \
    && mkdir -p /data && chown mgreg /data

COPY --from=build /mg-registry-server /usr/local/bin/mg-registry-server

USER mgreg
VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8080/v2/ || exit 1

ENTRYPOINT ["mg-registry-server", "--host", "0.0.0.0", "--port", "8080"]
