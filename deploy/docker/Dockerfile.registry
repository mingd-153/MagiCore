# MagiCore Registry Server — multi-stage build
# Usage: docker build -f deploy/docker/Dockerfile.registry -t magicore/registry-server .
# The locked workspace dependencies require Rust 1.94 or newer.
# Dependency đã khóa của workspace cần Rust 1.94 trở lên.
ARG RUST_IMAGE=docker.io/library/rust:1.94-slim-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

# ── Build stage ───────────────────────────────────────────────────────────────
FROM ${RUST_IMAGE} AS build
WORKDIR /build

RUN apt-get update -qq && apt-get install -y -qq \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY adapters/ adapters/
COPY cli/ cli/
COPY tools/ tools/
# Include the E2E workspace manifest so Cargo can resolve all members.
# Thêm manifest workspace E2E để Cargo phân giải đầy đủ các thành viên.
COPY tests/e2e/ tests/e2e/

# Cargo names this target `mgc-registry` although its package is `mgc-registry-server`.
# Cargo đặt tên binary là `mgc-registry` dù package có tên `mgc-registry-server`.
RUN cargo build --release --package mgc-registry-server && \
    cp target/release/mgc-registry /mgc-registry-server

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM ${RUNTIME_IMAGE}

RUN apt-get update -qq && apt-get install -y -qq wget ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -g root mgreg \
    && mkdir -p /data && chown mgreg /data

COPY --from=build /mgc-registry-server /usr/local/bin/mgc-registry-server

USER mgreg
VOLUME ["/data"]
EXPOSE 4315

# The registry challenges unauthenticated OCI pings; Wget exit 6 means it is reachable.
# Registry yêu cầu xác thực ở OCI ping; Wget exit 6 nghĩa là endpoint vẫn truy cập được.
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:4315/v2/ >/dev/null 2>&1 || test $? -eq 6

ENTRYPOINT ["mgc-registry-server", "--host", "0.0.0.0", "--port", "4315"]
